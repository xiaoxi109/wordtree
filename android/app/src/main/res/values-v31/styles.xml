<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ 系统启动页：暖纸底 + 品牌 L 字标，结束后切回主界面主题 -->
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/appCanvas</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash_logo</item>
        <item name="windowSplashScreenAnimationDuration">220</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
        <item name="android:statusBarColor">@color/appCanvas</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
</resources>
