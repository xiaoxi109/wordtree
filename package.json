{
  "name": "lexicore-learner",
  "private": true,
  "version": "0.28.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:android": "node scripts/version-bump.mjs code && cross-env TARGET=android tsc -b && cross-env TARGET=android vite build && npx cap sync",
    "version:bump": "node scripts/version-bump.mjs",
    "fill:ipa": "python scripts/fill_ipa.py && python scripts/generate_data.py",
    "gen:lexicon": "node tools/gen-ecdict.cjs",
    "gen:dicts": "node scripts/gen-dict-bundles.mjs",
    "gen:examples": "node tools/gen-examples.cjs run",
    "gen:examples:list": "node tools/gen-examples.cjs list",
    "gen:examples:next": "node tools/gen-examples.cjs next",
    "gen:examples:merge": "node tools/gen-examples.cjs merge",
    "gen:examples:qa": "node tools/gen-examples.cjs qa",
    "gen:examples:emit": "node tools/gen-examples.cjs emit",
    "gen:examples:report": "node tools/gen-examples.cjs report",
    "gen:books": "tsx tools/gen-book-bundles.ts",
    "report:scenes": "tsx tools/report-scenes.ts",
    "postinstall": "patch-package",
    "preview": "vite preview",
    "test": "vitest run",
    "e2e:ai": "tsx scripts/ai-e2e.ts"
  },
  "dependencies": {
    "@capacitor/android": "^8.4.2",
    "@capacitor/app": "^8.0.1",
    "@capacitor/cli": "^8.4.2",
    "@capacitor/core": "^8.4.2",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/status-bar": "^8.0.3",
    "@realtimex/piper-tts-web": "^1.1.1",
    "node-edge-tts": "^1.2.10",
    "onnxruntime-web": "1.18.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "cross-env": "^10.1.0",
    "jsdom": "^29.1.1",
    "patch-package": "^8.0.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.23.1",
    "typescript": "^5.6.3",
    "vite": "^6.0.5",
    "vitest": "^5.0.5"
  }
}
